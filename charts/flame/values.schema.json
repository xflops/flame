{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": { "type": "string" },
        "imageTag": { "type": "string" },
        "imagePullPolicy": { "type": "string" },
        "imagePullSecrets": { "type": "array" }
      }
    },
    "sessionManager": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "enum": [1] },
        "service": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP"] },
            "frontendPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "backendPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    },
    "objectCache": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "service": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "gc": {
          "type": "object",
          "properties": {
            "interval": { "type": "string", "minLength": 1 }
          },
          "required": ["interval"],
          "additionalProperties": false
        }
      }
    },
    "executorManager": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "trustDomain": { "type": "string", "minLength": 1 }
      },
      "required": ["enabled", "trustDomain"]
    },
    "tls": {
      "type": "object",
      "properties": {
        "mountPath": { "type": "string", "minLength": 1 },
        "sessionManager": {
          "type": "object",
          "properties": {
            "secretName": { "type": "string" },
            "certKey": { "type": "string", "minLength": 1 },
            "privateKeyKey": { "type": "string", "minLength": 1 },
            "caKey": { "type": "string", "minLength": 1 }
          },
          "required": ["secretName", "certKey", "privateKeyKey", "caKey"]
        },
        "objectCache": {
          "type": "object",
          "properties": {
            "secretName": { "type": "string" },
            "certKey": { "type": "string", "minLength": 1 },
            "privateKeyKey": { "type": "string", "minLength": 1 },
            "caKey": { "type": "string", "minLength": 1 }
          },
          "required": ["secretName", "certKey", "privateKeyKey", "caKey"]
        },
        "executorManager": {
          "type": "object",
          "properties": {
            "secretName": { "type": "string" },
            "certKey": { "type": "string", "minLength": 1 },
            "privateKeyKey": { "type": "string", "minLength": 1 },
            "caKey": { "type": "string", "minLength": 1 }
          },
          "required": ["secretName", "certKey", "privateKeyKey", "caKey"]
        }
      },
      "required": ["mountPath", "sessionManager", "objectCache", "executorManager"]
    },
    "clientConfig": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "tls": {
          "type": "object",
          "properties": {
            "certFile": { "type": "string" },
            "keyFile": { "type": "string" },
            "caFile": { "type": "string" }
          }
        }
      }
    }
  },
  "required": ["security", "tls"]
}
