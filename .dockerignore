# The images build Flame from source. Keep the context to Cargo workspace
# members and files used by flmadm install; runtime examples and E2E files are
# mounted by Compose instead of copied into the image.
*
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!common/
!config/
!cri/
!executor_manager/
!examples/
!flmadm/
!flmctl/
!flmexec/
!flmping/
!migrations/
!object_cache/
!rpc/
!sdk/
!session_manager/
!stdng/

# Build outputs, local environments, caches, and tests are not image inputs.
**/target/
**/.git/
**/.venv/
**/venv/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.tox/
**/.uv/
**/.pip/
**/build/
**/dist/
**/tests/
**/*.egg-info/
**/*.pyc
**/*.pyo
**/*.pyd
**/*.log
**/*.out
**/*.err
