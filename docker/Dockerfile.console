FROM rust:1.99.1 AS builder

WORKDIR /usr/src/flame
COPY . .

RUN apt-get update && apt-get install -y protobuf-compiler pkg-config libssl-dev
RUN cargo build --release

# uv builds the Python SDK wheel of the package and installs it
COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /uvx /usr/bin/

# Build the package (cargo reuses the build above), then install from it with the same scripts users run.
RUN scripts/build.sh --output /tmp/dist

# The client: the tools and flamepy for the Python of this image (Ubuntu 24.04's python3.12), installed by
# the sdk.sh the package carries, which uses the tools and the wheel in the package
RUN /tmp/dist/package/sbin/sdk.sh --prefix /usr/local/flame --python-version 3.12

FROM ubuntu:24.04

RUN apt-get update && apt-get install -y wget vim iputils-ping ssh curl jq python3 python3-pip && rm -rf /var/lib/apt/lists/*

# Copy the entire installation from builder (includes lib/ with flamepy and sbin/flmenv.sh)
COPY --from=builder /usr/local/flame /usr/local/flame

# Add flame binaries to PATH
ENV PATH="/usr/local/flame/bin:${PATH}"
ENV FLAME_HOME=/usr/local/flame

# flamepy is already in FLAME_HOME/lib; install the E2E runner and its timeout
# plugin so pyproject.toml's per-test timeout is enforced.
RUN pip3 install --break-system-packages pytest pytest-timeout

CMD ["service", "ssh", "start", "-D"]
