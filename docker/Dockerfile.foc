FROM rust:1.99.1 AS builder

WORKDIR /usr/src/flame
COPY . .

RUN apt-get update && apt-get install -y protobuf-compiler pkg-config libssl-dev
RUN cargo build --release

# uv builds the Python SDK wheel of the package
COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /uvx /usr/bin/

# Build the package (cargo reuses the build above), then install from it with the same scripts users run.
RUN scripts/build.sh --output /tmp/dist

# A worker install; the image keeps only the object cache. The joined head and the interface only
# name the default config, which the deployment replaces.
RUN /tmp/dist/package/sbin/setup.sh --prefix /usr/local/flame --join --no-systemd --force

FROM ubuntu:24.04

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/local/flame

COPY --from=builder /usr/local/flame/bin/flame-object-cache /usr/local/flame/bin/flame-object-cache

RUN mkdir -p /var/lib/flame/cache

ENV FLAME_HOME=/usr/local/flame

ENTRYPOINT ["/usr/local/flame/bin/flame-object-cache"]
