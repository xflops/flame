FROM rust:1.99.1 AS builder

WORKDIR /usr/src/flame
COPY . .

RUN apt-get update && apt-get install -y protobuf-compiler pkg-config libssl-dev
RUN cargo build --release

# Copy uv before flmadm install (flmadm will detect and copy it to FLAME_HOME/bin)
COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /uvx /usr/bin/

# Install using flmadm with worker profile
# This builds wheel and installs flamepy to lib/ via --prefix
RUN ./target/release/flmadm install \
    --src-dir /usr/src/flame \
    --prefix /usr/local/flame \
    --worker \
    --no-systemd \
    --skip-build \
    --force

FROM ubuntu:24.04

# The executor manager hosts host-shim applications, including the `flmbox` sandbox
# application, which drives gVisor `runsc`: runsc comes from the gVisor apt repository (the
# source the CRI e2e uses). curl and gnupg are only needed to add the repository.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg \
    && curl -fsSL https://gvisor.dev/archive.key \
        | gpg --dearmor -o /usr/share/keyrings/gvisor-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/gvisor-archive-keyring.gpg] https://storage.googleapis.com/gvisor/releases release main" \
        > /etc/apt/sources.list.d/gvisor.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends runsc python3-pip git dumb-init \
    && apt-get purge -y --auto-remove curl gnupg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/local/flame/work

# Copy the entire installation from builder (includes lib/ with flamepy)
COPY --from=builder /usr/local/flame /usr/local/flame

ENV FLAME_HOME=/usr/local/flame
# The Python of this image (Ubuntu 24.04's python3): the default of applications that name none.
ENV FLAME_PYTHON_VERSION=3.12

ENTRYPOINT ["/usr/bin/dumb-init", "--", "/usr/local/flame/bin/flame-executor-manager"]
