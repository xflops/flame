FROM rust:1.98.1 AS builder

WORKDIR /usr/src/flame
COPY . .

# Keep the compilation prefix identical across the five publishing targets.
RUN apt-get update && apt-get install -y protobuf-compiler pkg-config libssl-dev
RUN cargo build --release

COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /uvx /usr/bin/

RUN ./target/release/flmadm install \
    --src-dir /usr/src/flame \
    --prefix /usr/local/flame \
    --worker \
    --no-systemd \
    --skip-build \
    --force \
    --python-version 3.12 \
    && rm -f /usr/local/flame/bin/flame-executor-manager

FROM ubuntu:24.04

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates python3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/flame /usr/local/flame

ENV FLAME_HOME=/usr/local/flame
ENV PATH=/usr/local/flame/bin:${PATH}
ENV PYTHONPATH=/usr/local/flame/lib/python3.12/site-packages
# Device and driver injection is selected explicitly through CRI CDI requests.
ENV NVIDIA_VISIBLE_DEVICES=void

WORKDIR /var/lib/flame
