FROM rust:1.99.1 AS builder

WORKDIR /usr/src/flame
COPY . .

# Keep the compilation prefix identical across the five publishing targets.
RUN apt-get update && apt-get install -y protobuf-compiler pkg-config libssl-dev
RUN cargo build --release

COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /uvx /usr/bin/

# Build the package (cargo reuses the build above), then install from it with the same scripts users run.
RUN scripts/build.sh --output /tmp/dist

# A worker install without the services the runtime does not run: the joined head and the interface
# only name the default config.
RUN /tmp/dist/package/sbin/setup.sh --prefix /usr/local/flame --join --no-systemd --force \
    && rm -f /usr/local/flame/bin/flame-executor-manager /usr/local/flame/bin/flame-object-cache

FROM ubuntu:24.04

# The runtime also hosts the `flmbox` sandbox application, which drives gVisor `runsc`: runsc
# comes from the gVisor apt repository (the same source the CRI e2e uses). curl and gnupg
# are only needed to add the repository.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg python3 \
    && curl -fsSL https://gvisor.dev/archive.key \
        | gpg --dearmor -o /usr/share/keyrings/gvisor-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/gvisor-archive-keyring.gpg] https://storage.googleapis.com/gvisor/releases release main" \
        > /etc/apt/sources.list.d/gvisor.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends runsc \
    && apt-get purge -y --auto-remove curl gnupg \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/flame /usr/local/flame

ENV FLAME_HOME=/usr/local/flame
# The Python of this image (Ubuntu 24.04's python3): the default of applications that name none.
ENV FLAME_PYTHON_VERSION=3.12
ENV PATH=/usr/local/flame/bin:${PATH}
# Device and driver injection is selected explicitly through CRI CDI requests.
ENV NVIDIA_VISIBLE_DEVICES=void

WORKDIR /var/lib/flame
