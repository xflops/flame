FROM rust:1.100.0 AS builder

WORKDIR /usr/src/flame
COPY . .

RUN apt-get update && apt-get install -y protobuf-compiler pkg-config libssl-dev
RUN cargo build --release

# uv builds the Python SDK wheel of the package
COPY --from=ghcr.io/astral-sh/uv:0.13.8 /uv /uvx /usr/bin/

# Build the package (cargo reuses the build above), then install from it with the same scripts users run.
RUN scripts/build.sh --output /tmp/dist

# The head node: the session manager and the application manifests
RUN /tmp/dist/package/sbin/setup.sh --prefix /usr/local/flame --no-systemd --force

FROM ubuntu:24.04

WORKDIR /usr/local/flame

# Copy the entire installation from builder
COPY --from=builder /usr/local/flame /usr/local/flame

ENV FLAME_HOME=/usr/local/flame

ENTRYPOINT ["/usr/local/flame/bin/flame-session-manager"]
